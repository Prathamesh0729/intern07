
# Program to calculate Mean, Median and Mode

data = list(map(float, input("Enter dataset elements: ").split()))

n = len(data)

# Mean
mean = sum(data) / n

# Median
data.sort()

if n % 2 == 0:
    median = (data[n//2 - 1] + data[n//2]) / 2
else:
    median = data[n//2]

# Mode
max_count = 0
mode = []

for i in range(n):
    count = 0

    for j in range(n):
        if data[i] == data[j]:
            count += 1

    if count > max_count:
        max_count = count
        mode = [data[i]]
    elif count == max_count and data[i] not in mode:
        mode.append(data[i])

print("Mean =", mean)
print("Median =", median)

if max_count == 1:
    print("No Mode")
else:
    print("Mode =", mode)
