
# Program to calculate Variance, Standard Deviation and Outliers

data = list(map(float, input("Enter dataset elements: ").split()))

n = len(data)

if n < 2:
    print("Enter at least two data values.")
else:
    # Calculate Mean
    mean = sum(data) / n

    # Calculate Variance (Population)
    total = 0
    for x in data:
        total += (x - mean) ** 2

    variance = total / n

    # Calculate Standard Deviation
    std_dev = variance ** 0.5

    # Sort data for outlier detection
    data.sort()

    # Calculate Q1 and Q3 using median of halves
    if n % 2 == 0:
        lower = data[:n//2]
        upper = data[n//2:]
    else:
        lower = data[:n//2]
        upper = data[n//2+1:]

    def find_median(arr):
        m = len(arr)
        if m == 0:
            return 0
        if m % 2 == 0:
            return (arr[m//2-1] + arr[m//2]) / 2
        else:
            return arr[m//2]

    q1 = find_median(lower)
    q3 = find_median(upper)

    iqr = q3 - q1

    # Outlier limits
    lower_limit = q1 - 1.5 * iqr
    upper_limit = q3 + 1.5 * iqr

    outliers = []

    for x in data:
        if x < lower_limit or x > upper_limit:
            outliers.append(x)

    print("\nMean =", mean)
    print("Variance =", variance)
    print("Standard Deviation =", std_dev)
    print("Q1 =", q1)
    print("Q3 =", q3)
    print("IQR =", iqr)
    print("Outliers =", outliers)
